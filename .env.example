APP_NAME=TheSPARK
APP_ENV=production
APP_KEY=
# Never true on a live site: debug pages print passwords and file paths
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# PostgreSQL (e.g. Supabase) instead: set DB_CONNECTION=pgsql and DB_URL to the "Session pooler" connection string,
# and leave the DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD lines above empty. See DEPLOYMENT.md, section 10.
# DB_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Uploaded photos and PDFs are stored in the database itself, so no storage disk is needed.

# Short-lived copies of the public reader lists (home, categories, videos, gallery, issues) are kept here.
# "database" works everywhere; "redis" or "memcached" is faster if the server has one.
CACHE_STORE=database
# Request-limit counters (throttling, sign-in lockouts) are touched by every request, so they use the server's disk
# instead of the database: one less database round trip per request. Empty = same store as above.
CACHE_LIMITER_STORE=file

# Optional CDN: serve the built CSS/JS from another address, e.g. https://cdn.example.com (no trailing path).
# Set it BEFORE running `npm run build`, since the address is written into the built files.
ASSET_URL=

# The site signs in with tokens, not cookie sessions, so nothing is stored per visitor
SESSION_DRIVER=array
SESSION_LIFETIME=120

# Sign-in tokens stop working after this many minutes (10080 = 7 days)
SANCTUM_TOKEN_EXPIRATION=10080

# Content-Security-Policy for pages: enforce (blocks anything not allowed), report (only lists problems in the
# browser console) or off. Leave empty for the default: enforce on a live site, report while developing.
CSP_MODE=

# Extra origins allowed to call the API from a browser (comma separated). The site's own URL is always allowed.
CORS_ALLOWED_ORIGINS=

# Hosts without cron (Render): an outside timer calls /api/cron/run every minute with this key in an
# "Authorization: Bearer ..." header. 24+ random characters; empty switches the address off. See DEPLOYMENT.md, section 10.
CRON_SECRET=

# Sign-up email code. ON by default: sign-up emails a 6-digit code before the account is created. Set to false only on a
# host that cannot send email (new accounts are then created straight away, without proving the email).
SIGNUP_OTP_ENABLED=true

# Email (sign-up codes, password resets, newsletter). Use an app password, never the account password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TheSPARK"
