APP_NAME=TheSPARK
APP_ENV=production
APP_KEY=
# Never true on a live site: debug pages print passwords and file paths
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Short-lived copies of the public reader lists (home, categories, videos, gallery, issues) are kept here.
# "database" works everywhere; "redis" or "memcached" is faster if the server has one.
CACHE_STORE=database

# Optional CDN: serve the built CSS/JS from another address, e.g. https://cdn.example.com (no trailing path).
# Set it BEFORE running `npm run build`, since the address is written into the built files.
ASSET_URL=

# The site signs in with tokens, not cookie sessions, so nothing is stored per visitor
SESSION_DRIVER=array
SESSION_LIFETIME=120

# Sign-in tokens stop working after this many minutes (10080 = 7 days)
SANCTUM_TOKEN_EXPIRATION=10080

# Content-Security-Policy for pages: enforce (blocks anything not allowed), report (only lists problems in the
# browser console) or off. Leave empty for the default: enforce on a live site, report while developing.
CSP_MODE=

# Extra origins allowed to call the API from a browser (comma separated). The site's own URL is always allowed.
CORS_ALLOWED_ORIGINS=

# Email (sign-up codes, password resets, newsletter). Use an app password, never the account password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TheSPARK"
