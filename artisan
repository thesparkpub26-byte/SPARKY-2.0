#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

// Check If The Application Is Under Maintenance...
if (file_exists($maintenance = __DIR__.'/storage/framework/maintenance.php')) {
    require $maintenance;
}

// Register The Auto Loader...
if (file_exists(__DIR__.'/vendor/autoload.php')) {
    require __DIR__.'/vendor/autoload.php';
}

// Bootstrap Laravel and handle the command...
if (file_exists(__DIR__.'/bootstrap/app.php')) {
    $app = require_once __DIR__.'/bootstrap/app.php';
    if (method_exists($app, 'handleCommand')) {
        $status = $app->handleCommand(
            new Symfony\Component\Console\Input\ArgvInput
        );
        exit($status);
    }
}

// Built-in Lightweight Router Fallback for local serving
if (php_sapi_name() === 'cli') {
    $command = $argv[1] ?? '';
    if ($command === 'serve') {
        $host = '127.0.0.1';
        $port = '8000';
        echo "Starting Laravel development server: http://{$host}:{$port}\n";
        passthru("php -S {$host}:{$port} -t public public/index.php");
        exit(0);
    }
}
